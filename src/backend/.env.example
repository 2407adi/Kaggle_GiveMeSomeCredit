# Required: OpenAI key for the analyst summary / recommendation on /predict
OPENAI_API_KEY=

# Optional: comma-separated origins allowed by CORS
# (defaults to http://localhost:5173,http://localhost:8080)
# Add your deployed frontend origin here, e.g.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://creditrisk-frontend.<env>.azurecontainerapps.io
ALLOWED_ORIGINS=

# Optional: directory containing xgb_model.joblib / calibrator.joblib (default: model)
MODEL_DIR=

# Optional: credit score scaling (defaults: 600 / 50)
SCORE_BASE=
SCORE_FACTOR=
